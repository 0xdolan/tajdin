{
  "name": "@tajdin/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "wxt prepare",
    "lint:firefox": "addons-linter .output/firefox-mv2"
  },
  "dependencies": {
    "@tajdin/core": "workspace:*",
    "@tajdin/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tajdin/tsconfig": "workspace:*",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4",
    "addons-linter": "^10.14.0"
  }
}
