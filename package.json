{
  "name": "tajdin-monorepo",
  "private": true,
  "version": "0.1.4",
  "description": "Tajdîn — always by your side. Internet radio for your browser and the web.",
  "license": "MIT",
  "author": "0xdolan",
  "homepage": "https://0xdolan.github.io/tajdin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdolan/tajdin.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tajdin/extension",
    "dev:firefox": "pnpm --filter @tajdin/extension dev:firefox",
    "dev:web": "turbo run dev --filter=@tajdin/web",
    "build": "turbo run build",
    "build:extension": "pnpm --filter @tajdin/extension zip && pnpm --filter @tajdin/extension zip:firefox && node scripts/zip-sources.mjs",
    "build:web": "turbo run build --filter=@tajdin/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "release:notes": "node scripts/release-notes.mjs",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md",
    "version:bump": "node scripts/bump-version.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/build-icons.mjs",
    "prepare": "husky",
    "release:start": "node scripts/release.mjs start",
    "release:finish": "node scripts/release.mjs finish",
    "store-images": "node scripts/store-images.mjs",
    "zip:sources": "node scripts/zip-sources.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "git-cliff": "^2.14.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "sharp": "^0.35.5",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  }
}
